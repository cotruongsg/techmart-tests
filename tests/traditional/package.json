{
  "name": "techmart-tests",
  "version": "1.0.0",
  "description": "Traditional test suite for TechMart demo app",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:tunnel": "node run-tunnel-test.js",
    "test:api:tunnel": "node run-tunnel-test.js -- tests/api.spec.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.42.0",
    "cloudflared": "^0.7.3"
  }
}
